        "api",
        "apiverve",
        "magic8ball",
        "magic 8 ball",
        "fortune teller",
        "random answer",
        "prediction",
        "decision maker"
    ],
    "homepage": "https://apiverve.com/marketplace/magic8ball?utm_source=php&utm_medium=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/magic8ball",
        "source": "https://github.com/apiverve/magic8ball-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
